{
  "name": "open-record-studio",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Independent local screen and webcam recorder with synchronized separate exports",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:native && npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "release:mac": "npm run typecheck && npm run test:e2e && node scripts/release-mac.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "build:native": "node scripts/build-native.mjs",
    "pretest": "npm run build:native",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node --test tests/mcp.test.mjs",
    "test:mcp:packaged": "node scripts/test-packaged-mcp.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.2.0",
    "@electron/osx-sign": "2.7.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "electron": "44.7.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "productName": "Open Record Studio",
  "main": "desktop/main.mjs",
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  }
}
